{
  "name": "Nordlys Journal",
  "id": "nordlys-journal",
  "version": "0.1.0",
  "updated": "2026-10-16",
  "repository": "https://github.com/stavroslitsos/nordlys-webstudio",
  "branch": "main",
  "website": "https://nordlyswebstudio.no/journal/",
  "sourceDirectory": "journal",
  "documentationDirectory": "_project-docs/nordlys-journal",
  "manifest": "_project-docs/nordlys-journal/MANIFEST.md",
  "hosting": "GitHub Pages",
  "defaults": {
    "transcription": "soniox",
    "region": "eu",
    "notes": "openai-gpt56-sol",
    "mode": "streaming",
    "autoClearSupplementary": true
  },
  "backup": {
    "provider": "Google Drive",
    "scope": "https://www.googleapis.com/auth/drive.appdata",
    "keysAndPromptsRoundtripVerified": true,
    "passwordManagerSupport": true,
    "userPasswordAutofillVerified": false
  },
  "sensitiveDataIncluded": false,
  "masterRules": {
    "scope": "all-primary-note-workspaces-on-origin",
    "storage": "localStorage",
    "includedInCombinedEncryptedSetup": true,
    "promptControlsPresentation": true
  }
}
